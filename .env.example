# LearnPath Engine Environment Configuration Template
# Copy this file to .env for local deployment configuration

# Server Configuration
PORT=8000
HOST=localhost
NODE_ENV=development

# Model Hyperparameters
DEFAULT_LATENT_FACTORS=8
DEFAULT_LEARNING_RATE=0.01
DEFAULT_REGULARIZATION=0.01
DEFAULT_EPOCHS=100
DEFAULT_SEED=42

# Storage Keys (localStorage namespace)
STORAGE_KEY_RATINGS=pathiq_ratings
STORAGE_KEY_WEIGHTS=pathiq_model_weights
STORAGE_KEY_CONFIG=pathiq_model_config
